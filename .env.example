# KROK Trainer environment configuration (.env)
# Copy to /home/ubuntu/krok_trainer/.env (chmod 600) and fill secrets.

# Telegram Login Widget (configure @BotFather -> /setdomain krokflow.pp.ua)
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=

# Comma-separated Telegram IDs with admin permissions (pregeneration / review)
KROK_ADMIN_TG_IDS=123456789

# Gemini Flash API for single-generation cached explanations (never exposed to guests)
GEMINI_API_KEY=
KROK_GEMINI_MODEL=gemini-2.5-flash
KROK_EXPLAIN_DAILY_LIMIT=30
